{
  "schema": 1,
  "id": "claude-oauth",
  "name": "Claude OAuth",
  "tagline": "Claude OAuth 2.0 — authorization-code + PKCE for Claude providers",
  "description": "Wires Claude OAuth 2.0 authorization-code + PKCE (authorize_url, token_url, client_id, Claude scopes) for the Claude provider type. Provides the oauth feature only. Install the matching provider-type extension alongside it for headers, tools and client signature. Endpoints and scopes are supplied by this JSON — the gateway does not hardcode them.",
  "version": "4",
  "author": "aurora",
  "homepage": "",
  "license": "MIT",
  "type": "sidecar",
  "provides": {
    "features": [
      "external_auth"
    ]
  },
  "settings": {
    "oauth_grant": "authorization_code",
    "oauth_authorize_url": "https://claude.com/cai/oauth/authorize",
    "oauth_token_url": "https://platform.claude.com/v1/oauth/token",
    "oauth_token_style": "json",
    "oauth_client_id": "9d1c250a-e61b-44d9-88ed-5944d1962f5e",
    "oauth_scopes": "org:create_api_key user:profile user:inference user:sessions:claude_code user:mcp_servers user:file_upload",
    "oauth_redirect_uri": "http://127.0.0.1:54545/callback"
  },
  "requirements": [],
  "notes": [
    "Authorization-code + PKCE (S256). Paste CODE#STATE or the full callback URL after the browser redirects to localhost.",
    "Pairs with a provider-type extension for base_url, headers and tools.",
    "Review third-party extensions before installing them from a store."
  ],
  "ui": {
    "accent": "#D97757",
    "docs_url": "",
    "help": "Claude OAuth 2.0 — authorization-code + PKCE for Claude providers. Endpoints come from this extension — no hardcoded core origins."
  },
  "files": {
    "auth-claude.go": [
      "// addon-kind: auth",
      "package main",
      "",
      "import (",
      "\t\"bytes\"",
      "\t\"crypto/rand\"",
      "\t\"crypto/sha256\"",
      "\t\"encoding/base64\"",
      "\t\"encoding/json\"",
      "\t\"fmt\"",
      "\t\"io\"",
      "\t\"net/http\"",
      "\t\"net/url\"",
      "\t\"os\"",
      "\t\"path/filepath\"",
      "\t\"strings\"",
      "\t\"sync\"",
      "\t\"time\"",
      ")",
      "",
      "// extID is the extension that ships this addon. Ownership, endpoints and",
      "// scopes all come from that extension's manifest — nothing is hardcoded.",
      "const extID = \"claude-oauth\"",
      "",
      "const (",
      "\textensionsListPath  = \"configs/extensions.json\"",
      "\toverridesListPath   = \"configs/provider-overrides.json\"",
      "\tsidecarDefaultsPath = \"configs/sidecar-overrides.json\"",
      "\ttokenDataDir        = \"data\"",
      "\trefreshSkew         = 5 * time.Minute",
      ")",
      "",
      "var (",
      "\tcfgMu     sync.Mutex",
      "\tpendingMu sync.Mutex",
      "\tpending   = map[string]*pendingAuth{}",
      ")",
      "",
      "func UI() string {",
      "\treturn `{\"settings_tabs\":[{\"id\":\"oauth-authcode\",\"label\":\"Claude OAuth 2.0\",\"icon\":\"key\",\"order\":11,\"blocks\":[{\"kind\":\"heading\",\"text\":\"Claude OAuth 2.0 — authorization code + PKCE\"},{\"kind\":\"text\",\"text\":\"This flow is installed by the Claude OAuth 2.0 extension. Endpoints and scopes are declared in the extension JSON; nothing is hardcoded in the gateway core.\"},{\"kind\":\"list\",\"items\":[\"Open Providers, pick a Claude provider with external auth\",\"Choose Connect — your browser opens the authorize URL\",\"Approve; the browser redirects to the loopback callback\",\"Paste the callback URL (code + state) back into the dialog\"]},{\"kind\":\"kv\",\"kv\":[{\"k\":\"Authorize URL\",\"v\":\"https://claude.com/cai/oauth/authorize\"},{\"k\":\"Token URL\",\"v\":\"https://platform.claude.com/v1/oauth/token\"},{\"k\":\"Redirect URI\",\"v\":\"http://127.0.0.1:54545/callback\"},{\"k\":\"PKCE\",\"v\":\"S256\"}]}]}]}`",
      "}",
      "",
      "// ---------------------------------------------------------------------------",
      "// generic helpers",
      "",
      "func errResp(format string, args ...any) string {",
      "\treturn objJSON(map[string]any{\"error\": fmt.Sprintf(format, args...)})",
      "}",
      "",
      "func skipResp(provider string) string {",
      "\treturn objJSON(map[string]any{",
      "\t\t\"error\":    \"provider not found or external auth not configured: \" + provider,",
      "\t\t\"skip\":     true,",
      "\t\t\"provider\": provider,",
      "\t})",
      "}",
      "",
      "func objJSON(v any) string {",
      "\tb, err := json.Marshal(v)",
      "\tif err != nil {",
      "\t\treturn `{\"error\":\"encode failed\"}`",
      "\t}",
      "\treturn string(b)",
      "}",
      "",
      "func inMap(payload string) (map[string]any, bool) {",
      "\tvar m map[string]any",
      "\tif err := json.Unmarshal([]byte(payload), &m); err != nil || m == nil {",
      "\t\treturn map[string]any{}, false",
      "\t}",
      "\treturn m, true",
      "}",
      "",
      "func str(v any) string {",
      "\ts, _ := v.(string)",
      "\treturn strings.TrimSpace(s)",
      "}",
      "",
      "func trimSlash(s string) string {",
      "\treturn strings.TrimRight(strings.TrimSpace(s), \"/\")",
      "}",
      "",
      "func readJSON(path string, out any) bool {",
      "\tdata, err := os.ReadFile(path)",
      "\tif err != nil {",
      "\t\treturn false",
      "\t}",
      "\treturn json.Unmarshal(data, out) == nil",
      "}",
      "",
      "// safeTokenName keeps provider names inside a single path segment.",
      "func safeTokenName(provider string) string {",
      "\tvar b strings.Builder",
      "\tfor _, r := range provider {",
      "\t\tswitch {",
      "\t\tcase r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9',",
      "\t\t\tr == '-', r == '_', r == '.':",
      "\t\t\tb.WriteRune(r)",
      "\t\tdefault:",
      "\t\t\tb.WriteByte('_')",
      "\t\t}",
      "\t}",
      "\treturn b.String()",
      "}",
      "",
      "// ---------------------------------------------------------------------------",
      "// extension manifest / auth block",
      "",
      "type authConfig struct {",
      "\tServer           string",
      "\tClientID         string",
      "\tVerificationBase string",
      "\tUserAgent        string",
      "\tScope            string",
      "\tGrant            string",
      "\tAuthorizeURL     string",
      "\tTokenURL         string",
      "\tTokenStyle       string",
      "\tScopes           string",
      "\tStateIsVerifier  bool",
      "\tRedirectURI      string",
      "}",
      "",
      "func manifestList() []map[string]any {",
      "\tvar asList []map[string]any",
      "\tif readJSON(extensionsListPath, &asList) {",
      "\t\treturn asList",
      "\t}",
      "\tvar wrapped struct {",
      "\t\tExtensions []map[string]any `json:\"extensions\"`",
      "\t}",
      "\tif readJSON(extensionsListPath, &wrapped) {",
      "\t\treturn wrapped.Extensions",
      "\t}",
      "\treturn nil",
      "}",
      "",
      "func findExtension(id string) map[string]any {",
      "\tfor _, e := range manifestList() {",
      "\t\tif str(e[\"id\"]) == id {",
      "\t\t\treturn e",
      "\t\t}",
      "\t}",
      "\treturn nil",
      "}",
      "",
      "// ownManifest returns this addon's extension record (nil = not applied).",
      "func ownManifest() map[string]any {",
      "\tcfgMu.Lock()",
      "\tdefer cfgMu.Unlock()",
      "\treturn findExtension(extID)",
      "}",
      "",
      "func blockAuth(ext map[string]any) map[string]any {",
      "\tif b, ok := ext[\"auth\"].(map[string]any); ok && len(b) > 0 {",
      "\t\treturn b",
      "\t}",
      "\t// Legacy manifest key (pre-rename deployments).",
      "\tif b, ok := ext[\"oauth\"].(map[string]any); ok && len(b) > 0 {",
      "\t\treturn b",
      "\t}",
      "\treturn nil",
      "}",
      "",
      "func overrideField(field string) string {",
      "\tvar list []map[string]any",
      "\tif !readJSON(overridesListPath, &list) {",
      "\t\treturn \"\"",
      "\t}",
      "\tfor _, o := range list {",
      "\t\tif !externalish(str(o[\"auth_method\"])) {",
      "\t\t\tcontinue",
      "\t\t}",
      "\t\tif v := str(o[field]); v != \"\" {",
      "\t\t\treturn v",
      "\t\t}",
      "\t}",
      "\treturn \"\"",
      "}",
      "",
      "func sidecarField(field string) string {",
      "\tvar m map[string]any",
      "\tif !readJSON(sidecarDefaultsPath, &m) {",
      "\t\treturn \"\"",
      "\t}",
      "\treturn str(m[field])",
      "}",
      "",
      "func externalish(authMethod string) bool {",
      "\tswitch strings.ToLower(authMethod) {",
      "\tcase \"external\", \"oauth\":",
      "\t\treturn true",
      "\t}",
      "\treturn false",
      "}",
      "",
      "// loadAuth builds the auth config for this addon: manifest first, override",
      "// files only as fallbacks for legacy deployments.",
      "func loadAuth() (authConfig, bool) {",
      "\text := ownManifest()",
      "\tif ext == nil {",
      "\t\treturn authConfig{}, false",
      "\t}",
      "\tcfg := authConfig{}",
      "\tif b := blockAuth(ext); b != nil {",
      "\t\tcfg.Server = str(b[\"server\"])",
      "\t\tcfg.ClientID = str(b[\"client_id\"])",
      "\t\tcfg.VerificationBase = str(b[\"verification_base\"])",
      "\t\tcfg.UserAgent = str(b[\"user_agent\"])",
      "\t\tcfg.Scope = str(b[\"scope\"])",
      "\t\tcfg.Grant = strings.ToLower(str(b[\"grant\"]))",
      "\t\tcfg.AuthorizeURL = str(b[\"authorize_url\"])",
      "\t\tcfg.TokenURL = str(b[\"token_url\"])",
      "\t\tcfg.TokenStyle = str(b[\"token_style\"])",
      "\t\tcfg.Scopes = str(b[\"scopes\"])",
      "\t\tcfg.StateIsVerifier, _ = b[\"state_is_verifier\"].(bool)",
      "\t\tcfg.RedirectURI = str(b[\"redirect_uri\"])",
      "\t}",
      "\tif cfg.Server == \"\" {",
      "\t\tcfg.Server = overrideField(\"oauth_server\")",
      "\t}",
      "\tif cfg.Server == \"\" {",
      "\t\tcfg.Server = sidecarField(\"oauth_server\")",
      "\t}",
      "\tif cfg.ClientID == \"\" {",
      "\t\tcfg.ClientID = overrideField(\"oauth_client_id\")",
      "\t}",
      "\tif cfg.ClientID == \"\" {",
      "\t\tcfg.ClientID = sidecarField(\"oauth_client_id\")",
      "\t}",
      "\tif cfg.VerificationBase == \"\" {",
      "\t\tcfg.VerificationBase = overrideField(\"oauth_verification_base\")",
      "\t}",
      "\tif cfg.Grant == \"\" {",
      "\t\tcfg.Grant = \"device\"",
      "\t}",
      "\tif cfg.Grant == \"authorization_code\" {",
      "\t\treturn cfg, true",
      "\t}",
      "\tif cfg.Server == \"\" || cfg.ClientID == \"\" {",
      "\t\treturn cfg, false",
      "\t}",
      "\treturn cfg, true",
      "}",
      "",
      "func (c authConfig) httpc() *http.Client {",
      "\treturn &http.Client{Timeout: 30 * time.Second}",
      "}",
      "",
      "func (c authConfig) applyUA(req *http.Request) {",
      "\treq.Header.Set(\"Accept\", \"application/json\")",
      "\tif c.UserAgent != \"\" {",
      "\t\treq.Header.Set(\"User-Agent\", c.UserAgent)",
      "\t}",
      "}",
      "",
      "// ---------------------------------------------------------------------------",
      "// provider ownership",
      "",
      "func providerRecords() []map[string]any {",
      "\tvar list []map[string]any",
      "\tif !readJSON(overridesListPath, &list) {",
      "\t\treturn nil",
      "\t}",
      "\treturn list",
      "}",
      "",
      "func extMatchesProvider(ext map[string]any, rec map[string]any) bool {",
      "\tif b, ok := ext[\"provides\"].(map[string]any); ok {",
      "\t\tif types, ok := b[\"provider_types\"].([]any); ok {",
      "\t\t\tpt := strings.ToLower(str(rec[\"type\"]))",
      "\t\t\tfor _, t := range types {",
      "\t\t\t\tif pt != \"\" && pt == strings.ToLower(str(t)) {",
      "\t\t\t\t\treturn true",
      "\t\t\t\t}",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "\tif extBase := trimSlash(str(ext[\"base_url\"])); extBase != \"\" {",
      "\t\tif trimSlash(str(rec[\"base_url\"])) == extBase {",
      "\t\t\treturn true",
      "\t\t}",
      "\t}",
      "\treturn false",
      "}",
      "",
      "func extHasExplicitRules(ext map[string]any) bool {",
      "\tif str(ext[\"base_url\"]) != \"\" {",
      "\t\treturn true",
      "\t}",
      "\tif b, ok := ext[\"provides\"].(map[string]any); ok {",
      "\t\tif types, ok := b[\"provider_types\"].([]any); ok {",
      "\t\t\treturn len(types) > 0",
      "\t\t}",
      "\t}",
      "\treturn false",
      "}",
      "",
      "// ownedProviders lists the provider records this addon is responsible for.",
      "func ownedProviders() []map[string]any {",
      "\town := ownManifest()",
      "\tif own == nil {",
      "\t\treturn nil",
      "\t}",
      "\tvar others []map[string]any",
      "\tfor _, e := range manifestList() {",
      "\t\tif str(e[\"id\"]) == extID {",
      "\t\t\tcontinue",
      "\t\t}",
      "\t\tif extHasExplicitRules(e) {",
      "\t\t\tothers = append(others, e)",
      "\t\t}",
      "\t}",
      "\tvar out []map[string]any",
      "\tfor _, rec := range providerRecords() {",
      "\t\tif !externalish(str(rec[\"auth_method\"])) {",
      "\t\t\tcontinue",
      "\t\t}",
      "\t\tif extMatchesProvider(own, rec) {",
      "\t\t\tout = append(out, rec)",
      "\t\t\tcontinue",
      "\t\t}",
      "\t\tif extHasExplicitRules(own) {",
      "\t\t\tcontinue",
      "\t\t}",
      "\t\t// No explicit rules in my own extension: only take providers that no",
      "\t\t// rule-bearing extension claims.",
      "\t\tclaimed := false",
      "\t\tfor _, o := range others {",
      "\t\t\tif extMatchesProvider(o, rec) {",
      "\t\t\t\tclaimed = true",
      "\t\t\t\tbreak",
      "\t\t\t}",
      "\t\t}",
      "\t\tif !claimed {",
      "\t\t\tout = append(out, rec)",
      "\t\t}",
      "\t}",
      "\treturn out",
      "}",
      "",
      "func providerOwned(name string) (map[string]any, bool) {",
      "\tfor _, rec := range ownedProviders() {",
      "\t\tif str(rec[\"name\"]) == name {",
      "\t\t\treturn rec, true",
      "\t\t}",
      "\t}",
      "\treturn nil, false",
      "}",
      "",
      "// ---------------------------------------------------------------------------",
      "// authorization-code + PKCE (RFC 7636)",
      "",
      "type pendingAuth struct {",
      "\tcfg       authConfig",
      "\tverifier  string",
      "\tstate     string",
      "\texpiresAt time.Time",
      "}",
      "",
      "func generateVerifier() (string, error) {",
      "\tb := make([]byte, 32)",
      "\tif _, err := rand.Read(b); err != nil {",
      "\t\treturn \"\", err",
      "\t}",
      "\treturn base64.RawURLEncoding.EncodeToString(b), nil",
      "}",
      "",
      "func generateState() (string, error) {",
      "\tb := make([]byte, 16)",
      "\tif _, err := rand.Read(b); err != nil {",
      "\t\treturn \"\", err",
      "\t}",
      "\treturn base64.RawURLEncoding.EncodeToString(b), nil",
      "}",
      "",
      "func challengeS256(verifier string) (string, error) {",
      "\tsum := sha256.Sum256([]byte(verifier))",
      "\treturn base64.RawURLEncoding.EncodeToString(sum[:]), nil",
      "}",
      "",
      "func authCodeStart(cfg authConfig) (map[string]any, error) {",
      "\tcfg.AuthorizeURL = strings.TrimSpace(cfg.AuthorizeURL)",
      "\tcfg.ClientID = strings.TrimSpace(cfg.ClientID)",
      "\tif cfg.AuthorizeURL == \"\" || cfg.ClientID == \"\" {",
      "\t\treturn nil, fmt.Errorf(\"authorization_code not configured (apply an extension that supplies authorize_url/token_url/client_id)\")",
      "\t}",
      "\tredirect := cfg.RedirectURI",
      "\tif redirect == \"\" {",
      "\t\tredirect = \"http://127.0.0.1:54545/callback\"",
      "\t}",
      "\ttokenStyle := cfg.TokenStyle",
      "\tif tokenStyle == \"\" {",
      "\t\ttokenStyle = \"json\"",
      "\t}",
      "\tverifier, err := generateVerifier()",
      "\tif err != nil {",
      "\t\treturn nil, err",
      "\t}",
      "\tchallenge, err := challengeS256(verifier)",
      "\tif err != nil {",
      "\t\treturn nil, err",
      "\t}",
      "\tstate, err := generateState()",
      "\tif err != nil {",
      "\t\treturn nil, err",
      "\t}",
      "\tif cfg.StateIsVerifier {",
      "\t\tstate = verifier",
      "\t}",
      "\tu, err := url.Parse(cfg.AuthorizeURL)",
      "\tif err != nil {",
      "\t\treturn nil, fmt.Errorf(\"invalid authorize_url: %w\", err)",
      "\t}",
      "\tq := u.Query()",
      "\tq.Set(\"response_type\", \"code\")",
      "\tq.Set(\"client_id\", cfg.ClientID)",
      "\tq.Set(\"redirect_uri\", redirect)",
      "\tq.Set(\"code_challenge\", challenge)",
      "\tq.Set(\"code_challenge_method\", \"S256\")",
      "\tq.Set(\"state\", state)",
      "\tif scopes := strings.TrimSpace(cfg.Scopes); scopes != \"\" {",
      "\t\tq.Set(\"scope\", scopes)",
      "\t}",
      "\tu.RawQuery = q.Encode()",
      "",
      "\tcfg.RedirectURI = redirect",
      "\tcfg.TokenStyle = tokenStyle",
      "\texpiresIn := 600",
      "\tpendingMu.Lock()",
      "\tpending[state] = &pendingAuth{",
      "\t\tcfg:       cfg,",
      "\t\tverifier:  verifier,",
      "\t\tstate:     state,",
      "\t\texpiresAt: time.Now().Add(time.Duration(expiresIn) * time.Second),",
      "\t}",
      "\tfor k, p := range pending {",
      "\t\tif time.Now().After(p.expiresAt) {",
      "\t\t\tdelete(pending, k)",
      "\t\t}",
      "\t}",
      "\tpendingMu.Unlock()",
      "",
      "\treturn map[string]any{",
      "\t\t\"authorize_url\": u.String(),",
      "\t\t\"state\":         state,",
      "\t\t\"redirect_uri\":  redirect,",
      "\t\t\"expires_in\":    expiresIn,",
      "\t\t\"grant\":         \"authorization_code\",",
      "\t}, nil",
      "}",
      "",
      "func tokenRequest(cfg authConfig, fields map[string]string) (*tokenResponse, error) {",
      "\tvar body []byte",
      "\tvar contentType string",
      "\tswitch strings.ToLower(strings.TrimSpace(cfg.TokenStyle)) {",
      "\tcase \"form\":",
      "\t\tv := url.Values{}",
      "\t\tfor k, val := range fields {",
      "\t\t\tv.Set(k, val)",
      "\t\t}",
      "\t\tbody = []byte(v.Encode())",
      "\t\tcontentType = \"application/x-www-form-urlencoded\"",
      "\tdefault:",
      "\t\tvar err error",
      "\t\tbody, err = json.Marshal(fields)",
      "\t\tif err != nil {",
      "\t\t\treturn nil, err",
      "\t\t}",
      "\t\tcontentType = \"application/json\"",
      "\t}",
      "\treq, err := http.NewRequest(\"POST\", cfg.TokenURL, bytes.NewReader(body))",
      "\tif err != nil {",
      "\t\treturn nil, fmt.Errorf(\"create token request: %w\", err)",
      "\t}",
      "\treq.Header.Set(\"Content-Type\", contentType)",
      "\tcfg.applyUA(req)",
      "\tresp, err := cfg.httpc().Do(req)",
      "\tif err != nil {",
      "\t\treturn nil, fmt.Errorf(\"token request failed: %w\", err)",
      "\t}",
      "\tdefer resp.Body.Close()",
      "\traw, err := io.ReadAll(resp.Body)",
      "\tif err != nil {",
      "\t\treturn nil, fmt.Errorf(\"read token response: %w\", err)",
      "\t}",
      "\tif resp.StatusCode != http.StatusOK {",
      "\t\treturn nil, fmt.Errorf(\"token exchange HTTP %d: %s\", resp.StatusCode, string(raw))",
      "\t}",
      "\tvar tok tokenResponse",
      "\tif err := json.Unmarshal(raw, &tok); err != nil {",
      "\t\treturn nil, fmt.Errorf(\"decode token response: %w\", err)",
      "\t}",
      "\tif tok.AccessToken == \"\" {",
      "\t\treturn nil, fmt.Errorf(\"token response missing access_token\")",
      "\t}",
      "\treturn &tok, nil",
      "}",
      "",
      "func authCodeComplete(state, code string) (*tokenResponse, error) {",
      "\tstate = strings.TrimSpace(state)",
      "\tcode = strings.TrimSpace(code)",
      "\tif state == \"\" || code == \"\" {",
      "\t\treturn nil, fmt.Errorf(\"state and code are required\")",
      "\t}",
      "\tpendingMu.Lock()",
      "\tp := pending[state]",
      "\tdelete(pending, state)",
      "\tpendingMu.Unlock()",
      "\tif p == nil {",
      "\t\treturn nil, fmt.Errorf(\"unknown or expired state\")",
      "\t}",
      "\tif time.Now().After(p.expiresAt) {",
      "\t\treturn nil, fmt.Errorf(\"authorize session expired\")",
      "\t}",
      "\tif p.cfg.TokenURL == \"\" {",
      "\t\treturn nil, fmt.Errorf(\"token_url is required for authorization code exchange\")",
      "\t}",
      "\tfields := map[string]string{",
      "\t\t\"grant_type\":    \"authorization_code\",",
      "\t\t\"code\":          code,",
      "\t\t\"redirect_uri\":  p.cfg.RedirectURI,",
      "\t\t\"client_id\":     p.cfg.ClientID,",
      "\t\t\"code_verifier\": p.verifier,",
      "\t\t\"state\":         state,",
      "\t}",
      "\treturn tokenRequest(p.cfg, fields)",
      "}",
      "",
      "func refreshAuthCode(cfg authConfig, refreshToken string) (*tokenResponse, error) {",
      "\tif cfg.TokenURL == \"\" {",
      "\t\treturn nil, fmt.Errorf(\"token_url is required for refresh\")",
      "\t}",
      "\tif refreshToken == \"\" {",
      "\t\treturn nil, fmt.Errorf(\"no refresh token\")",
      "\t}",
      "\tfields := map[string]string{",
      "\t\t\"grant_type\":    \"refresh_token\",",
      "\t\t\"refresh_token\": refreshToken,",
      "\t\t\"client_id\":     cfg.ClientID,",
      "\t}",
      "\tif scopes := strings.TrimSpace(cfg.Scopes); scopes != \"\" {",
      "\t\tfields[\"scope\"] = scopes",
      "\t}",
      "\treturn tokenRequest(cfg, fields)",
      "}",
      "",
      "// ---------------------------------------------------------------------------",
      "// device flow + token persistence (RFC 8628)",
      "",
      "type deviceCodeResponse struct {",
      "\tDeviceCode              string `json:\"device_code\"`",
      "\tUserCode                string `json:\"user_code\"`",
      "\tVerificationURIComplete string `json:\"verification_uri_complete\"`",
      "\tExpiresIn               int    `json:\"expires_in\"`",
      "\tInterval                int    `json:\"interval\"`",
      "}",
      "",
      "type tokenResponse struct {",
      "\tAccessToken  string `json:\"access_token\"`",
      "\tRefreshToken string `json:\"refresh_token\"`",
      "\tExpiresIn    int    `json:\"expires_in\"`",
      "}",
      "",
      "type tokenError struct {",
      "\tError string `json:\"error\"`",
      "}",
      "",
      "type storedToken struct {",
      "\tAccessToken  string    `json:\"access_token\"`",
      "\tRefreshToken string    `json:\"refresh_token\"`",
      "\tExpiresAt    time.Time `json:\"expires_at\"`",
      "\tServer       string    `json:\"server\"`",
      "\tClientID     string    `json:\"client_id\"`",
      "\tAccountID    string    `json:\"account_id,omitempty\"`",
      "\tEmail        string    `json:\"email,omitempty\"`",
      "}",
      "",
      "// manager owns the token state for one provider.",
      "type manager struct {",
      "\tprovider string",
      "\tcfg      authConfig",
      "",
      "\tmu               sync.RWMutex",
      "\ttoken            *storedToken",
      "\ttokenFileModTime time.Time",
      "}",
      "",
      "func tokenFilePath(provider string) string {",
      "\treturn filepath.Join(tokenDataDir, \"oauth_\"+safeTokenName(provider)+\".json\")",
      "}",
      "",
      "func newManager(provider string, cfg authConfig) *manager {",
      "\tm := &manager{provider: provider, cfg: cfg}",
      "\tm.loadToken()",
      "\treturn m",
      "}",
      "",
      "func (m *manager) loadToken() {",
      "\tpath := tokenFilePath(m.provider)",
      "\tdata, err := os.ReadFile(path)",
      "\tif err != nil {",
      "\t\treturn",
      "\t}",
      "\tvar t storedToken",
      "\tif err := json.Unmarshal(data, &t); err != nil {",
      "\t\treturn",
      "\t}",
      "\tm.token = &t",
      "\tif info, err := os.Stat(path); err == nil {",
      "\t\tm.tokenFileModTime = info.ModTime()",
      "\t}",
      "}",
      "",
      "func (m *manager) tryReloadToken() bool {",
      "\tpath := tokenFilePath(m.provider)",
      "\tinfo, err := os.Stat(path)",
      "\tif err != nil {",
      "\t\treturn false",
      "\t}",
      "\tif !info.ModTime().After(m.tokenFileModTime) {",
      "\t\treturn false",
      "\t}",
      "\tdata, err := os.ReadFile(path)",
      "\tif err != nil {",
      "\t\treturn false",
      "\t}",
      "\tvar t storedToken",
      "\tif err := json.Unmarshal(data, &t); err != nil {",
      "\t\treturn false",
      "\t}",
      "\tm.token = &t",
      "\tm.tokenFileModTime = info.ModTime()",
      "\treturn true",
      "}",
      "",
      "func (m *manager) saveToken() error {",
      "\tif err := os.MkdirAll(tokenDataDir, 0o700); err != nil {",
      "\t\treturn err",
      "\t}",
      "\tdata, err := json.MarshalIndent(m.token, \"\", \"  \")",
      "\tif err != nil {",
      "\t\treturn err",
      "\t}",
      "\tpath := tokenFilePath(m.provider)",
      "\tif err := os.WriteFile(path, data, 0o600); err != nil {",
      "\t\treturn err",
      "\t}",
      "\tif info, err := os.Stat(path); err == nil {",
      "\t\tm.tokenFileModTime = info.ModTime()",
      "\t}",
      "\treturn nil",
      "}",
      "",
      "func (m *manager) hasToken() bool {",
      "\tm.mu.Lock()",
      "\tdefer m.mu.Unlock()",
      "\tm.tryReloadToken()",
      "\treturn m.token != nil && m.token.AccessToken != \"\"",
      "}",
      "",
      "func (m *manager) tokenInfo() *storedToken {",
      "\tm.mu.Lock()",
      "\tdefer m.mu.Unlock()",
      "\tm.tryReloadToken()",
      "\tif m.token == nil {",
      "\t\treturn nil",
      "\t}",
      "\tcp := *m.token",
      "\treturn &cp",
      "}",
      "",
      "func (m *manager) startDeviceFlow() (*deviceCodeResponse, error) {",
      "\tif m.cfg.Server == \"\" {",
      "\t\treturn nil, fmt.Errorf(\"device flow requires an auth server (extension auth block)\")",
      "\t}",
      "\tbody, _ := json.Marshal(map[string]string{\"client_id\": m.cfg.ClientID})",
      "\treq, err := http.NewRequest(\"POST\", m.cfg.Server+\"/auth/device/code\", bytes.NewReader(body))",
      "\tif err != nil {",
      "\t\treturn nil, fmt.Errorf(\"create device code request: %w\", err)",
      "\t}",
      "\treq.Header.Set(\"Content-Type\", \"application/json\")",
      "\tm.cfg.applyUA(req)",
      "\tresp, err := m.cfg.httpc().Do(req)",
      "\tif err != nil {",
      "\t\treturn nil, fmt.Errorf(\"device code request failed: %w\", err)",
      "\t}",
      "\tdefer resp.Body.Close()",
      "\tif resp.StatusCode != http.StatusOK {",
      "\t\tb, _ := io.ReadAll(resp.Body)",
      "\t\treturn nil, fmt.Errorf(\"device code request returned HTTP %d: %s\", resp.StatusCode, string(b))",
      "\t}",
      "\tvar dc deviceCodeResponse",
      "\tif err := json.NewDecoder(resp.Body).Decode(&dc); err != nil {",
      "\t\treturn nil, fmt.Errorf(\"decode device code response: %w\", err)",
      "\t}",
      "\treturn &dc, nil",
      "}",
      "",
      "// exchangeDevice attempts one device_code exchange. pending reports",
      "// authorization_pending / slow_down without treating them as failures.",
      "func (m *manager) exchangeDevice(deviceCode string) (*tokenResponse, string, error) {",
      "\tbody, _ := json.Marshal(map[string]string{",
      "\t\t\"grant_type\":  \"urn:ietf:params:oauth:grant-type:device_code\",",
      "\t\t\"device_code\": deviceCode,",
      "\t\t\"client_id\":   m.cfg.ClientID,",
      "\t})",
      "\treq, err := http.NewRequest(\"POST\", m.cfg.Server+\"/auth/device/token\", bytes.NewReader(body))",
      "\tif err != nil {",
      "\t\treturn nil, \"\", fmt.Errorf(\"create token request: %w\", err)",
      "\t}",
      "\treq.Header.Set(\"Content-Type\", \"application/json\")",
      "\tm.cfg.applyUA(req)",
      "\tresp, err := m.cfg.httpc().Do(req)",
      "\tif err != nil {",
      "\t\treturn nil, \"\", fmt.Errorf(\"token request failed: %w\", err)",
      "\t}",
      "\tdefer resp.Body.Close()",
      "\tb, err := io.ReadAll(resp.Body)",
      "\tif err != nil {",
      "\t\treturn nil, \"\", fmt.Errorf(\"read token response: %w\", err)",
      "\t}",
      "\tif resp.StatusCode == http.StatusOK {",
      "\t\tvar tok tokenResponse",
      "\t\tif err := json.Unmarshal(b, &tok); err != nil {",
      "\t\t\treturn nil, \"\", fmt.Errorf(\"decode token response: %w\", err)",
      "\t\t}",
      "\t\treturn &tok, \"\", nil",
      "\t}",
      "\tvar terr tokenError",
      "\tif err := json.Unmarshal(b, &terr); err != nil {",
      "\t\treturn nil, \"\", fmt.Errorf(\"decode token error: %w\", err)",
      "\t}",
      "\tswitch terr.Error {",
      "\tcase \"authorization_pending\":",
      "\t\treturn nil, \"authorization_pending\", nil",
      "\tcase \"slow_down\":",
      "\t\treturn nil, \"slow_down\", nil",
      "\tcase \"expired_token\":",
      "\t\treturn nil, \"\", fmt.Errorf(\"device code expired, user must re-authorize\")",
      "\tcase \"access_denied\", \"authorization_denied\":",
      "\t\treturn nil, \"\", fmt.Errorf(\"authorization denied by user\")",
      "\tdefault:",
      "\t\treturn nil, \"\", fmt.Errorf(\"token error: %s\", terr.Error)",
      "\t}",
      "}",
      "",
      "func (m *manager) pollDevice(deviceCode string, interval time.Duration, expiresAt time.Time) (*tokenResponse, error) {",
      "\tfor {",
      "\t\tif time.Now().After(expiresAt) {",
      "\t\t\treturn nil, fmt.Errorf(\"device code expired\")",
      "\t\t}",
      "\t\ttime.Sleep(interval)",
      "\t\ttok, pending, err := m.exchangeDevice(deviceCode)",
      "\t\tif err != nil {",
      "\t\t\treturn nil, err",
      "\t\t}",
      "\t\tif tok != nil {",
      "\t\t\treturn tok, nil",
      "\t\t}",
      "\t\tif pending == \"slow_down\" {",
      "\t\t\tinterval += 5 * time.Second",
      "\t\t}",
      "\t}",
      "}",
      "",
      "func (m *manager) refresh() error {",
      "\tm.mu.Lock()",
      "\tdefer m.mu.Unlock()",
      "\tif m.token == nil || m.token.RefreshToken == \"\" {",
      "\t\treturn fmt.Errorf(\"no refresh token available\")",
      "\t}",
      "\tif m.cfg.TokenURL != \"\" {",
      "\t\ttok, err := refreshAuthCode(m.cfg, m.token.RefreshToken)",
      "\t\tif err != nil {",
      "\t\t\treturn err",
      "\t\t}",
      "\t\tm.token.AccessToken = tok.AccessToken",
      "\t\tif tok.RefreshToken != \"\" {",
      "\t\t\tm.token.RefreshToken = tok.RefreshToken",
      "\t\t}",
      "\t\tm.token.ExpiresAt = time.Now().Add(time.Duration(tok.ExpiresIn) * time.Second)",
      "\t\treturn m.saveToken()",
      "\t}",
      "\tif m.cfg.Server == \"\" {",
      "\t\treturn fmt.Errorf(\"no refresh endpoint configured\")",
      "\t}",
      "\tbody, _ := json.Marshal(map[string]string{",
      "\t\t\"grant_type\":    \"refresh_token\",",
      "\t\t\"refresh_token\": m.token.RefreshToken,",
      "\t\t\"client_id\":     m.cfg.ClientID,",
      "\t})",
      "\treq, err := http.NewRequest(\"POST\", m.cfg.Server+\"/auth/device/token\", bytes.NewReader(body))",
      "\tif err != nil {",
      "\t\treturn fmt.Errorf(\"create refresh request: %w\", err)",
      "\t}",
      "\treq.Header.Set(\"Content-Type\", \"application/json\")",
      "\tm.cfg.applyUA(req)",
      "\tresp, err := m.cfg.httpc().Do(req)",
      "\tif err != nil {",
      "\t\treturn fmt.Errorf(\"refresh request failed: %w\", err)",
      "\t}",
      "\tdefer resp.Body.Close()",
      "\tif resp.StatusCode != http.StatusOK {",
      "\t\tb, _ := io.ReadAll(resp.Body)",
      "\t\treturn fmt.Errorf(\"refresh returned HTTP %d: %s\", resp.StatusCode, string(b))",
      "\t}",
      "\tvar tok tokenResponse",
      "\tif err := json.NewDecoder(resp.Body).Decode(&tok); err != nil {",
      "\t\treturn fmt.Errorf(\"decode refresh response: %w\", err)",
      "\t}",
      "\tm.token.AccessToken = tok.AccessToken",
      "\tif tok.RefreshToken != \"\" {",
      "\t\tm.token.RefreshToken = tok.RefreshToken",
      "\t}",
      "\tm.token.ExpiresAt = time.Now().Add(time.Duration(tok.ExpiresIn) * time.Second)",
      "\treturn m.saveToken()",
      "}",
      "",
      "func (m *manager) ensureFresh() error {",
      "\tm.mu.RLock()",
      "\tif m.token == nil {",
      "\t\tm.mu.RUnlock()",
      "\t\treturn nil",
      "\t}",
      "\tif time.Now().Add(refreshSkew).Before(m.token.ExpiresAt) {",
      "\t\tm.mu.RUnlock()",
      "\t\treturn nil",
      "\t}",
      "\tm.mu.RUnlock()",
      "\treturn m.refresh()",
      "}",
      "",
      "func (m *manager) saveFromResponse(tok *tokenResponse) error {",
      "\tm.mu.Lock()",
      "\tdefer m.mu.Unlock()",
      "\tm.token = &storedToken{",
      "\t\tAccessToken:  tok.AccessToken,",
      "\t\tRefreshToken: tok.RefreshToken,",
      "\t\tExpiresAt:    time.Now().Add(time.Duration(tok.ExpiresIn) * time.Second),",
      "\t\tServer:       m.cfg.Server,",
      "\t\tClientID:     m.cfg.ClientID,",
      "\t}",
      "\tif m.cfg.Server != \"\" {",
      "\t\tif info := m.fetchAccountInfo(tok.AccessToken); info != nil {",
      "\t\t\tm.token.AccountID = info.AccountID",
      "\t\t\tm.token.Email = info.Email",
      "\t\t}",
      "\t}",
      "\treturn m.saveToken()",
      "}",
      "",
      "func (m *manager) clear() error {",
      "\tm.mu.Lock()",
      "\tdefer m.mu.Unlock()",
      "\tm.token = nil",
      "\tpath := tokenFilePath(m.provider)",
      "\tif err := os.Remove(path); err != nil && !os.IsNotExist(err) {",
      "\t\treturn err",
      "\t}",
      "\treturn nil",
      "}",
      "",
      "// fetchAccountInfo is best-effort metadata (email / account id).",
      "func (m *manager) fetchAccountInfo(accessToken string) *storedToken {",
      "\ttype userResponse struct {",
      "\t\tID    string `json:\"id\"`",
      "\t\tEmail string `json:\"email\"`",
      "\t}",
      "\ttype orgResponse struct {",
      "\t\tID string `json:\"id\"`",
      "\t}",
      "\tfetch := func(u string, out any) bool {",
      "\t\treq, err := http.NewRequest(\"GET\", u, nil)",
      "\t\tif err != nil {",
      "\t\t\treturn false",
      "\t\t}",
      "\t\treq.Header.Set(\"Authorization\", \"Bearer \"+accessToken)",
      "\t\tm.cfg.applyUA(req)",
      "\t\tresp, err := m.cfg.httpc().Do(req)",
      "\t\tif err != nil {",
      "\t\t\treturn false",
      "\t\t}",
      "\t\tdefer resp.Body.Close()",
      "\t\tif resp.StatusCode != http.StatusOK {",
      "\t\t\treturn false",
      "\t\t}",
      "\t\treturn json.NewDecoder(resp.Body).Decode(out) == nil",
      "\t}",
      "\tvar user userResponse",
      "\tvar orgs []orgResponse",
      "\tfetch(m.cfg.Server+\"/api/user\", &user)",
      "\tfetch(m.cfg.Server+\"/api/orgs\", &orgs)",
      "\tinfo := &storedToken{}",
      "\tif user.ID != \"\" {",
      "\t\tinfo.AccountID = user.ID",
      "\t}",
      "\tif user.Email != \"\" {",
      "\t\tinfo.Email = user.Email",
      "\t}",
      "\tif len(orgs) > 0 && info.AccountID == \"\" {",
      "\t\tinfo.AccountID = orgs[0].ID",
      "\t}",
      "\tif info.AccountID == \"\" && info.Email == \"\" {",
      "\t\treturn nil",
      "\t}",
      "\treturn info",
      "}",
      "",
      "// managerFor resolves the manager for a provider this addon owns.",
      "func managerFor(payload map[string]any) (*manager, string, bool) {",
      "\tprovider := str(payload[\"provider\"])",
      "\tif provider == \"\" {",
      "\t\treturn nil, \"\", false",
      "\t}",
      "\tif _, ok := providerOwned(provider); !ok {",
      "\t\treturn nil, provider, false",
      "\t}",
      "\tcfg, ok := loadAuth()",
      "\tif !ok {",
      "\t\treturn nil, provider, false",
      "\t}",
      "\treturn newManager(provider, cfg), provider, true",
      "}",
      "",
      "func verificationBaseFor(cfg authConfig, uri string) string {",
      "\turi = strings.TrimSpace(uri)",
      "\tif uri == \"\" {",
      "\t\treturn \"\"",
      "\t}",
      "\tif strings.HasPrefix(uri, \"http://\") || strings.HasPrefix(uri, \"https://\") {",
      "\t\treturn uri",
      "\t}",
      "\tbase := trimSlash(cfg.VerificationBase)",
      "\tif base == \"\" {",
      "\t\treturn uri",
      "\t}",
      "\tif !strings.HasPrefix(uri, \"/\") {",
      "\t\turi = \"/\" + uri",
      "\t}",
      "\treturn base + uri",
      "}",
      "",
      "func statusResp(m *manager, provider string) map[string]any {",
      "\tout := map[string]any{\"has_token\": false, \"expired\": false, \"provider_name\": provider}",
      "\tif info := m.tokenInfo(); info != nil {",
      "\t\tout[\"has_token\"] = true",
      "\t\tout[\"expired\"] = time.Now().After(info.ExpiresAt)",
      "\t\tout[\"expires_at\"] = info.ExpiresAt",
      "\t\tif info.Email != \"\" {",
      "\t\t\tout[\"email\"] = info.Email",
      "\t\t}",
      "\t\tif info.AccountID != \"\" {",
      "\t\t\tout[\"account_id\"] = info.AccountID",
      "\t\t}",
      "\t\tif info.Server != \"\" {",
      "\t\t\tout[\"server\"] = info.Server",
      "\t\t}",
      "\t}",
      "\treturn out",
      "}",
      "",
      "// ---------------------------------------------------------------------------",
      "// addon API — every method takes one JSON string and returns one JSON string",
      "",
      "// Start begins the device authorization flow for the provider.",
      "func Start(payload string) string {",
      "\tin, _ := inMap(payload)",
      "\tm, provider, ok := managerFor(in)",
      "\tif !ok {",
      "\t\treturn skipResp(str(in[\"provider\"]))",
      "\t}",
      "\tdc, err := m.startDeviceFlow()",
      "\tif err != nil {",
      "\t\treturn errResp(\"failed to start device flow: %v\", err)",
      "\t}",
      "\tinterval := dc.Interval",
      "\tif interval <= 0 {",
      "\t\tinterval = 5",
      "\t}",
      "\texpiresIn := dc.ExpiresIn",
      "\tif expiresIn <= 0 {",
      "\t\texpiresIn = 600",
      "\t}",
      "\texpiresAt := time.Now().Add(time.Duration(expiresIn) * time.Second)",
      "\tgo func() {",
      "\t\ttok, err := m.pollDevice(dc.DeviceCode, time.Duration(interval)*time.Second, expiresAt)",
      "\t\tif err != nil {",
      "\t\t\tfmt.Printf(\"external auth: background polling stopped provider=%s error=%v\\n\", provider, err)",
      "\t\t\treturn",
      "\t\t}",
      "\t\tif err := m.saveFromResponse(tok); err != nil {",
      "\t\t\tfmt.Printf(\"external auth: failed to save token provider=%s error=%v\\n\", provider, err)",
      "\t\t\treturn",
      "\t\t}",
      "\t\tfmt.Printf(\"external auth: token saved provider=%s\\n\", provider)",
      "\t}()",
      "\treturn objJSON(map[string]any{",
      "\t\t\"user_code\":                 dc.UserCode,",
      "\t\t\"verification_uri_complete\": verificationBaseFor(m.cfg, dc.VerificationURIComplete),",
      "\t\t\"verification_base\":         trimSlash(m.cfg.VerificationBase),",
      "\t\t\"expires_in\":                expiresIn,",
      "\t\t\"interval\":                  interval,",
      "\t})",
      "}",
      "",
      "// Poll performs one device-code exchange (manual polling).",
      "func Poll(payload string) string {",
      "\tin, _ := inMap(payload)",
      "\tm, _, ok := managerFor(in)",
      "\tif !ok {",
      "\t\treturn skipResp(str(in[\"provider\"]))",
      "\t}",
      "\tdeviceCode := str(in[\"device_code\"])",
      "\tif deviceCode == \"\" {",
      "\t\treturn errResp(\"device_code is required\")",
      "\t}",
      "\tintervalSec := 5",
      "\tif v, ok := in[\"interval\"].(float64); ok && int(v) > 0 {",
      "\t\tintervalSec = int(v)",
      "\t}",
      "\texpiresIn := 600",
      "\tif v, ok := in[\"expires_in\"].(float64); ok && int(v) > 0 {",
      "\t\texpiresIn = int(v)",
      "\t}",
      "\tinterval := time.Duration(intervalSec) * time.Second",
      "\texpiresAt := time.Now().Add(time.Duration(expiresIn) * time.Second)",
      "\tif time.Now().After(expiresAt) {",
      "\t\treturn objJSON(map[string]any{\"status\": \"error\", \"error\": \"device code expired\"})",
      "\t}",
      "\ttime.Sleep(interval)",
      "\ttok, _, err := m.exchangeDevice(deviceCode)",
      "\tif err != nil {",
      "\t\treturn objJSON(map[string]any{\"status\": \"error\", \"error\": err.Error()})",
      "\t}",
      "\tif tok == nil {",
      "\t\treturn objJSON(map[string]any{\"status\": \"pending\"})",
      "\t}",
      "\tif err := m.saveFromResponse(tok); err != nil {",
      "\t\treturn errResp(\"failed to save token: %v\", err)",
      "\t}",
      "\treturn objJSON(map[string]any{\"status\": \"authorized\", \"access_token\": tok.AccessToken})",
      "}",
      "",
      "// TokenStatus reports the stored token state for the provider.",
      "func TokenStatus(payload string) string {",
      "\tin, _ := inMap(payload)",
      "\tm, provider, ok := managerFor(in)",
      "\tif !ok {",
      "\t\treturn skipResp(str(in[\"provider\"]))",
      "\t}",
      "\treturn objJSON(statusResp(m, provider))",
      "}",
      "",
      "// Refresh forces a token refresh for the provider.",
      "func Refresh(payload string) string {",
      "\tin, _ := inMap(payload)",
      "\tm, provider, ok := managerFor(in)",
      "\tif !ok {",
      "\t\treturn skipResp(str(in[\"provider\"]))",
      "\t}",
      "\tif !m.hasToken() {",
      "\t\treturn errResp(\"no token stored for provider\")",
      "\t}",
      "\tif err := m.refresh(); err != nil {",
      "\t\treturn errResp(\"failed to refresh token: %v\", err)",
      "\t}",
      "\treturn objJSON(statusResp(m, provider))",
      "}",
      "",
      "// RefreshAll refreshes every stored token this addon owns.",
      "func RefreshAll(payload string) string {",
      "\tresults := make([]map[string]any, 0)",
      "\tfor _, rec := range ownedProviders() {",
      "\t\tname := str(rec[\"name\"])",
      "\t\tcfg, ok := loadAuth()",
      "\t\tif !ok {",
      "\t\t\tcontinue",
      "\t\t}",
      "\t\tm := newManager(name, cfg)",
      "\t\tif !m.hasToken() {",
      "\t\t\tcontinue",
      "\t\t}",
      "\t\tif err := m.refresh(); err != nil {",
      "\t\t\tresults = append(results, map[string]any{\"name\": name, \"error\": err.Error()})",
      "\t\t\tcontinue",
      "\t\t}",
      "\t\tresults = append(results, map[string]any{\"name\": name, \"refreshed\": true})",
      "\t}",
      "\treturn objJSON(results)",
      "}",
      "",
      "// ClearToken deletes the stored token for the provider.",
      "func ClearToken(payload string) string {",
      "\tin, _ := inMap(payload)",
      "\tm, _, ok := managerFor(in)",
      "\tif !ok {",
      "\t\treturn skipResp(str(in[\"provider\"]))",
      "\t}",
      "\tif err := m.clear(); err != nil {",
      "\t\treturn errResp(\"failed to clear token: %v\", err)",
      "\t}",
      "\treturn objJSON(map[string]any{\"status\": \"cleared\"})",
      "}",
      "",
      "// FlowInfo reports the active grant for the provider.",
      "func FlowInfo(payload string) string {",
      "\tin, _ := inMap(payload)",
      "\tprovider := str(in[\"provider\"])",
      "\tm, _, ok := managerFor(in)",
      "\tif !ok {",
      "\t\treturn skipResp(provider)",
      "\t}",
      "\tcfg := m.cfg",
      "\tgrant := cfg.Grant",
      "\tif grant == \"\" {",
      "\t\tgrant = \"device\"",
      "\t}",
      "\thasAuthCode := cfg.Grant == \"authorization_code\" || cfg.TokenURL != \"\"",
      "\treturn objJSON(map[string]any{",
      "\t\t\"provider\":           provider,",
      "\t\t\"grant\":              grant,",
      "\t\t\"has_token\":          m.hasToken(),",
      "\t\t\"authorization_code\": hasAuthCode,",
      "\t})",
      "}",
      "",
      "// StartAuthorize creates a PKCE session and returns the authorize URL.",
      "func StartAuthorize(payload string) string {",
      "\tin, _ := inMap(payload)",
      "\tm, _, ok := managerFor(in)",
      "\tif !ok {",
      "\t\treturn skipResp(str(in[\"provider\"]))",
      "\t}",
      "\tcfg := m.cfg",
      "\tif v := str(in[\"redirect_uri\"]); v != \"\" {",
      "\t\tcfg.RedirectURI = v",
      "\t}",
      "\tif v := str(in[\"scope\"]); v != \"\" {",
      "\t\tcfg.Scopes = v",
      "\t}",
      "\tout, err := authCodeStart(cfg)",
      "\tif err != nil {",
      "\t\treturn errResp(\"%v\", err)",
      "\t}",
      "\treturn objJSON(out)",
      "}",
      "",
      "// CompleteAuthorize exchanges a pasted/redirected authorization code.",
      "func CompleteAuthorize(payload string) string {",
      "\tin, _ := inMap(payload)",
      "\tm, _, ok := managerFor(in)",
      "\tif !ok {",
      "\t\treturn skipResp(str(in[\"provider\"]))",
      "\t}",
